# Flask Application Configuration
PORT=5000
SECRET_KEY=codebuddy-super-secret-jwt-key-2025
JWT_SECRET_KEY=codebuddy-jwt-signing-secret-key-9876
JWT_EXPIRES_HOURS=24

# Database Configuration
# Default: SQLite (out-of-the-box local storage)
DATABASE_URL=sqlite:///codebuddy.db

# To use MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/codebuddy

# Judge0 Code Execution Service (https://rapidapi.com/judge0-official/api/judge0-ce)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# AI Coding Assistant
# Supports Gemini, OpenAI, Claude, or Groq
AI_API_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
