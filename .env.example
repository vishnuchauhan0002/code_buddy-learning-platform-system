# =====================================================================
# CODEBUDDY — ENVIRONMENT CONFIGURATION TEMPLATE
# =====================================================================

# ---------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel / Local Vite)
# ---------------------------------------------------------------------
# Points the React frontend to the backend REST API
# Localhost default: http://localhost:5000/api
# Production (Vercel) example: https://your-backend.onrender.com/api
VITE_API_BASE_URL=http://localhost:5000/api


# ---------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render / Railway / Local Flask)
# ---------------------------------------------------------------------
PORT=5000
FLASK_ENV=development

# Security Secrets (Generate random strings for production)
SECRET_KEY=codebuddy-super-secret-jwt-key-2025
JWT_SECRET_KEY=codebuddy-jwt-signing-secret-key-9876
JWT_EXPIRES_HOURS=24

# Database URL
# SQLite (Local development default):
DATABASE_URL=sqlite:///codebuddy.db
# MySQL Production example:
# DATABASE_URL=mysql+pymysql://username:password@hostname:3306/codebuddy
# PostgreSQL Production example:
# DATABASE_URL=postgresql://username:password@hostname:5432/codebuddy

# Allowed Frontend Origins for CORS (comma-separated)
# Local: http://localhost:5173,http://127.0.0.1:5173
# Production: https://your-site.vercel.app,*
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ---------------------------------------------------------------------
# 3. EXTERNAL SERVICES (Optional — Built-in offline fallback provided)
# ---------------------------------------------------------------------

# Judge0 Sandboxed Code Execution API (https://rapidapi.com/judge0-official/api/judge0-ce)
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your_rapidapi_judge0_key_here
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com

# AI Coding Assistant (Gemini / OpenAI)
AI_API_PROVIDER=gemini
AI_API_KEY=your_gemini_or_openai_api_key_here
AI_MODEL=gemini-1.5-flash
